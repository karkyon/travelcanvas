[flake8]
# [Gate M9] lint債務解消とCI blocking化。
#
# 2026-09-13時点でリポジトリにflake8設定が一切存在せず、デフォルトの
# max-line-length=79でCIの非blocking flake8ステップを実測すると
# backend/app配下だけで2,112件(内訳: E501行長超過986件、W293/W291/W292
# 空白系918件、E302/E303/E305空行数135+1+12件、F401未使用import50件、
# その他少数)。この大半は実際のバグではなく形式的な指摘であり、
# 「現実的なルールセット」として以下を採用する。
#
# max-line-length=120: 79は現代のディスプレイ環境や本プロジェクトの
#   命名慣習(日本語コメント・長いエンドポイントパス等)に対して
#   厳しすぎ、指摘の大半(986/2112)を占めていた。120は多くの企業
#   スタイルガイドで採用される現実的な値。120超過後も残る行は
#   個別に折り返し修正する(app配下で8件のみ)。
#
# extend-ignore=E203,W503: どちらもPEP8自体が「どちらでも良い」と
#   明記し互いに矛盾しうるルール(二項演算子の前/後で改行、コロン前の
#   空白)。black(backend/requirements.txtに依存として存在)の出力
#   スタイルと衝突するため、blackを将来的に有効化した場合の手戻りを
#   避ける目的でも除外する。
#
# exclude alembic/versions: 適用済みの過去マイグレーションファイル
#   211件(E122/E127/E128継続行インデント、5ファイルに集中)。
#   純粋なフォーマット指摘でSQLの意味には影響しないが、過去に適用
#   済みの履歴ファイルを書き換える価値がCI blocking化の目的に対して
#   低いため、除外する。alembic/env.py等の実運用コードは対象のまま。
max-line-length = 120
extend-ignore = E203,W503
exclude =
    .git,
    __pycache__,
    alembic/versions,
    .venv,
    venv,
    build,
    dist
