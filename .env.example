# TravelCanvas Environment Variables (React + Vite Enhanced)
# Copy this file to .env.local and fill in your values

# Application
APP_NAME=TravelCanvas
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=your_super_secret_key_here_change_this
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this
ENCRYPTION_KEY=your_encryption_key_here_change_this

# Database
DATABASE_URL=postgresql://travelcanvas:password@localhost:5432/travelcanvas_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=travelcanvas
DB_PASSWORD=your_password_here
DB_NAME_DEV=travelcanvas_dev
DB_NAME_TEST=travelcanvas_test
DB_NAME_PROD=travelcanvas_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Celery (Task Queue)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Configuration
API_V1_PREFIX=/api/v1
API_RATE_LIMIT=100/hour
API_CORS_ORIGINS=["http://localhost:3000","https://localhost:3000"]

# Security
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CSRF_TRUSTED_ORIGINS=["http://localhost:3000"]
SESSION_EXPIRE_SECONDS=86400

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=./static/uploads
ALLOWED_FILE_TYPES=["jpg","jpeg","png","gif","pdf","docx"]

# Document Wallet (FR-013) - 文書ダウンロード署名付きURL
# 外部サービス連携は無し。JWT_SECRET_KEY/ENCRYPTION_KEYと同様、ローカルで
# 生成したランダムな秘密鍵をHMAC-SHA256の署名鍵として使う(hashlib実装は
# backend/app/services/storage_backend.pyのissue_download_token()参照)。
# 未設定の場合、文書ダウンロードURL発行APIは503(DownloadSigningNotConfigured)
# を返す。[Gate M10 v21] omega-dev2等の実機.envでは自動生成される。
DOCUMENT_DOWNLOAD_SIGNING_KEY=your_document_download_signing_key_here_change_this
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=120
# [Gate S4] ウイルス検査(none / clamav)。clamav は `docker compose --profile malware-scan up -d clamav` で起動する
# (Runbook §3.8)。DOCUMENT_REQUIRE_CLEAN_SCAN=true で、検査済み(clean)の文書だけを受け付け・配る。
MALWARE_SCAN_BACKEND=none
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
DOCUMENT_REQUIRE_CLEAN_SCAN=false
# [Gate S4] 要求の本文の上限(バイト)。ファイルの受け取り口は DOCUMENT_MAX_UPLOAD_SIZE_BYTES + 1MB まで
# API_MAX_BODY_BYTES=2097152

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
FROM_EMAIL=noreply@travelcanvas.com

# External APIs
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
WEATHER_API_KEY=

# Optimization Settings
OR_TOOLS_SOLVER=CBC
OPTIMIZATION_TIMEOUT=300
MAX_OPTIMIZATION_ITERATIONS=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=detailed
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_BACKUP_COUNT=5

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Development
HOT_RELOAD=true
AUTO_MIGRATION=true
SEED_DATABASE=true

# Frontend (React + Vite)
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=TravelCanvas
VITE_APP_VERSION=1.0.0
VITE_DEV_PORT=3000

# React Native (Future)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_APP_NAME=TravelCanvas
EXPO_PUBLIC_APP_VERSION=1.0.0

# [Gate O1/K1/S2] 本番(APP_ENV=production / staging)では、次の値が弱い・未設定・同じ値の使い回しだと
# backend が起動を拒否する(app/core/config.py の production_problems)。本番では DEBUG=false にし、
# 各鍵は用途ごとに別の32文字以上の乱数にすること(例: python3 -c "import secrets;print(secrets.token_urlsafe(48))")。
# CORS_ORIGINS は https の画面のオリジンだけ(localhost・* は不可)。
LOOKUP_INDEX_KEY=your_lookup_index_key_here_change_this
# /metrics を守るトークン(本番は必須、24文字以上)
METRICS_TOKEN=your_metrics_token_here_change_this
# オフラインデータの鍵の元(任意。未設定なら ENCRYPTION_KEY から導出。変えると全員の端末のオフラインデータが読めなくなる)
# OFFLINE_PACK_KEY_SECRET=your_offline_pack_key_secret_here_change_this
