# TravelCanvas Environment Variables (React + Vite Enhanced)
# Copy this file to .env.local and fill in your values

# Application
APP_NAME=TravelCanvas
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=your_super_secret_key_here_change_this
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this
ENCRYPTION_KEY=your_encryption_key_here_change_this

# Database
DATABASE_URL=postgresql://travelcanvas:password@localhost:5432/travelcanvas_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=travelcanvas
DB_PASSWORD=your_password_here
DB_NAME_DEV=travelcanvas_dev
DB_NAME_TEST=travelcanvas_test
DB_NAME_PROD=travelcanvas_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Celery (Task Queue)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Configuration
API_V1_PREFIX=/api/v1
API_RATE_LIMIT=100/hour
API_CORS_ORIGINS=["http://localhost:3000","https://localhost:3000"]

# Security
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CSRF_TRUSTED_ORIGINS=["http://localhost:3000"]
SESSION_EXPIRE_SECONDS=86400

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=./static/uploads
ALLOWED_FILE_TYPES=["jpg","jpeg","png","gif","pdf","docx"]

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
FROM_EMAIL=noreply@travelcanvas.com

# External APIs
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
WEATHER_API_KEY=

# Optimization Settings
OR_TOOLS_SOLVER=CBC
OPTIMIZATION_TIMEOUT=300
MAX_OPTIMIZATION_ITERATIONS=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=detailed
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_BACKUP_COUNT=5

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Development
HOT_RELOAD=true
AUTO_MIGRATION=true
SEED_DATABASE=true

# Frontend (React + Vite)
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=TravelCanvas
VITE_APP_VERSION=1.0.0
VITE_DEV_PORT=3000

# React Native (Future)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_APP_NAME=TravelCanvas
EXPO_PUBLIC_APP_VERSION=1.0.0
