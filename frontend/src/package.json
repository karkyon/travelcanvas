{
  "name": "travelcanvas-frontend",
  "version": "1.0.0",
  "description": "TravelCanvas - 次世代AI旅行計画プラットフォーム",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "analyze": "npm run build && npx vite-bundle-analyzer dist/stats.html",
    "prepare": "husky install"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "@tanstack/react-query": "^4.35.3",
    "zustand": "^4.4.4",
    "axios": "^1.5.1",
    "framer-motion": "^10.16.4",
    "date-fns": "^2.30.0",
    "react-hook-form": "^7.47.0",
    "@hookform/resolvers": "^3.3.2",
    "zod": "^3.22.4",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "dompurify": "^3.0.5",
    "lodash": "^4.17.21",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^0.287.0",
    "react-beautiful-dnd": "^13.1.1",
    "socket.io-client": "^4.7.2",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "@types/dompurify": "^3.0.3",
    "@types/lodash": "^4.14.199",
    "@types/react-beautiful-dnd": "^13.1.5",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "@vitejs/plugin-react": "^4.1.0",
    "vite": "^4.4.11",
    "typescript": "^5.2.2",
    "tailwindcss": "^3.3.5",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "eslint": "^8.51.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.6",
    "vitest": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/user-event": "^14.5.1",
    "jsdom": "^22.1.0",
    "msw": "^1.3.2",
    "@playwright/test": "^1.39.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.2",
    "@tanstack/react-query-devtools": "^4.35.3",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-plugin-pwa": "^0.16.5",
    "workbox-core": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/travelcanvas-frontend.git"
  },
  "keywords": [
    "travel",
    "planning",
    "ai",
    "optimization",
    "react",
    "typescript",
    "pwa"
  ],
  "author": "TravelCanvas Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-org/travelcanvas-frontend/issues"
  },
  "homepage": "https://travelcanvas.app"
}